# Copy to .env. Values for REFERENCE_* come from `npx supabase status -o env`
# (API_URL and ANON_KEY).
REFERENCE_URL=http://127.0.0.1:54321
REFERENCE_KEY=
# Lite target. Leave TARGET_KEY empty to let the kit sign one with LITE_JWT_SECRET.
TARGET_URL=http://127.0.0.1:54400
# TARGET_KEY=
# LITE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
